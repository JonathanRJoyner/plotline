{
  "name": "plotline-web",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "npm run wasm:engine && npm run wasm:models",
    "wasm:engine": "wasm-pack build ../crates/wasm --release --target web --out-dir ../../web/pkg",
    "wasm:models": "wasm-pack build ../crates/models --release --target web --out-dir ../../web/pkg-models --features web",
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit && vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "lucide-preact": "^1.55.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "typescript": "~5.9",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}

"""Types for ``plotline._core``, the Rust engine built as an extension module (crates/py)."""

from typing import Any, Literal

import numpy as np
from numpy.typing import NDArray

_State = Literal["idle", "running", "done", "cancelled", "error"]

class Run:
    def next_frame(self) -> dict[str, Any] | None: ...
    def cancel(self) -> None: ...
    def state(self) -> _State: ...
    def error(self) -> str | None: ...
    def result(self) -> dict[str, Any] | None: ...

class Session:
    def __init__(self, cache_bytes: int = 536870912) -> None: ...
    def set_image_bytes(self, data: bytes) -> None: ...
    def set_image(self, array: NDArray[np.float32]) -> None: ...
    def image(self) -> NDArray[np.float32] | None: ...
    def canvas(self) -> dict[str, Any]: ...
    def set_canvas(self, canvas: dict[str, Any]) -> None: ...
    def pens(self) -> list[dict[str, Any]]: ...
    def set_pens(self, pens: list[dict[str, Any]]) -> None: ...
    def style_name(self) -> str: ...
    def set_style(self, name: str) -> None: ...
    def reset_settings(self) -> None: ...
    def settings(self) -> dict[str, Any]: ...
    def update(self, stage: str, patch: dict[str, Any]) -> None: ...
    def speeds(self) -> dict[str, float]: ...
    def set_speeds(self, speeds: dict[str, float]) -> None: ...
    def start(self) -> Run: ...
    def fit(self, metric: str, target: float) -> Run: ...
    def state(self) -> _State: ...
    def error(self) -> str | None: ...
    def drawing(self) -> dict[str, Any] | None: ...
    def svg(self) -> str | None: ...
    def json(self) -> dict[str, Any] | None: ...
    def stats(self) -> dict[str, Any] | None: ...
    def lint(self) -> list[dict[str, Any]] | None: ...
    def analysis(self) -> dict[str, Any] | None: ...
    def preview_png(
        self,
        width_px: int,
        travel: bool,
        source: bool,
        region: tuple[float, float, float, float] | None = None,
    ) -> bytes | None: ...
    def preset(self) -> dict[str, Any]: ...
    def load_preset(self, preset: dict[str, Any]) -> list[str]: ...
    def cache_stats(self) -> dict[str, int]: ...
    def clear_cache(self) -> None: ...

def list_styles() -> list[dict[str, str]]: ...
def describe(name: str) -> dict[str, Any]: ...
def inks() -> dict[str, str]: ...
def synthetic_gradient(w: int, h: int) -> NDArray[np.float32]: ...
def synthetic_checkerboard(w: int, h: int, cells: int) -> NDArray[np.float32]: ...
def synthetic_radial(w: int, h: int) -> NDArray[np.float32]: ...
def synthetic_noise(w: int, h: int, seed: int) -> NDArray[np.float32]: ...
def synthetic_flat(w: int, h: int, value: float) -> NDArray[np.float32]: ...
